# ==============================================================================
# IDEAS & COLORES MULTI-SERVICIOS — CONFIGURACIÓN DE ENTORNO Y PRODUCCIÓN
# Dominio de Producción: https://ideasycoloresgt.site/
# Servidor: Hostinger Shared Hosting / Node Daemon
# ==============================================================================

# Entorno de Ejecución
NODE_ENV="production"
PORT="3001"

# Seguridad CORS (Orígenes autorizados separados por coma)
# En desarrollo localhost está permitido automáticamente
ALLOWED_ORIGINS="https://ideasycoloresgt.site,https://www.ideasycoloresgt.site"

# ------------------------------------------------------------------------------
# HOSTINGER TITAN SMTP — NOTIFICACIONES DE COTIZACIÓN AUTOMÁTICAS
# ------------------------------------------------------------------------------
HOSTINGER_SMTP_HOST="smtp.hostinger.com"
HOSTINGER_SMTP_PORT="465"
HOSTINGER_SMTP_SECURE="true"
HOSTINGER_SMTP_USER="gerencia@ideasycoloresgt.com"
HOSTINGER_SMTP_PASS="tu_contraseña_de_correo_hostinger_aqui"
SMTP_FROM_NAME="Ideas & Colores Cotizaciones"
SMTP_NOTIFICATION_EMAIL="gerencia@ideasycoloresgt.com"

# ------------------------------------------------------------------------------
# ATENCIÓN Y ENRUTAMIENTO WHATSAPP (Formato: 502XXXXXXXX sin signos ni espacios)
# ------------------------------------------------------------------------------
WHATSAPP_TARGET_NUMBER="50266617592"

# ------------------------------------------------------------------------------
# DISPATCHER EXTERNO CRM / WEBHOOK (Opcional - Google Sheets, Make, Notion)
# ------------------------------------------------------------------------------
# WEBHOOK_CRM_URL="https://hook.eu1.make.com/your-webhook-id"

# ------------------------------------------------------------------------------
# SUPABASE CONFIGURATION (Base de datos y analítica secundaria)
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key-here"
